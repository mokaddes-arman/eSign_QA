# Copy to .env and fill in real values. Never commit .env (it is git-ignored).
BASE_URL=https://esignpro.net

# --- Test account -----------------------------------------------------------
ESIGN_NAME=
ESIGN_COMPANY=
ESIGN_EMAIL=
ESIGN_PASSWORD=
ESIGN_COMPANY_TYPE=Other
ESIGN_COMPANY_SIZE=1–50

# --- Session / OTP ----------------------------------------------------------
# `npm run auth:save` writes the signed-in session here.
AUTH_STATE_PATH=auth/storageState.json
# One-time code from the verification e-mail (optional; leave empty for prompt/IMAP).
OTP_CODE=

# Optional: read the OTP from Gmail automatically (Google App Password, 2FA required).
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Opt-in suites (true to enable) ----------------------------------------
# Upload/golden-path cases consume the monthly signature-request quota.
RUN_UPLOAD=false
# Creates a brand-new workspace through /register.
RUN_SIGNUP=false
# Adds a sandbox card / switches plan (Stripe test mode only).
RUN_PAYMENT=false
# Signs in during the run (UF-05). The account allows ONE active session, so this
# signs out the saved session — run that spec on its own.
RUN_LOGIN_FLOW=false

# --- Stripe TEST card (only used when RUN_PAYMENT=true) ----------------------
# Use Stripe's public test card; never a real card.
CARD_NUMBER=4242424242424242
CARD_EXPIRY=12/34
CARD_CVC=123
CARD_NAME=QA Tester
CARD_COUNTRY=US

# --- Reporting ---------------------------------------------------------------
# Known-bug tests: "strict" (default, fail while the bug exists) or
# "expect-fail" (wrapped in test.fail so a pipeline stays green until fixed).
KNOWN_BUGS=strict
# Dashboard tab after a run: auto (local only) | always | never
DASHBOARD_OPEN=auto
# debug | info | warn | error
LOG_LEVEL=info
