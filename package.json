{
  "name": "esignpro-qa-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript (POM) automation suite for https://esignpro.net",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:ui-checks": "playwright test tests/ui",
    "test:flows": "playwright test tests/flows",
    "test:bugs": "playwright test --grep @bug",
    "test:api": "playwright test --project=chromium --grep @api",
    "test:security": "playwright test --project=chromium --grep @security",
    "test:a11y": "playwright test --project=chromium --grep @a11y",
    "test:perf": "playwright test --project=chromium-account tests/performance",
    "test:compat": "playwright test --project=chromium --grep @compat",
    "test:cross-browser": "playwright test --project=firefox --project=webkit --project=mobile-chrome --grep @smoke --workers=2",
    "test:ci": "playwright test --project=chromium --project=chromium-builder --grep-invert \"@data|@perf\"",
    "report": "playwright show-report",
    "report:dashboard": "node -e \"require('child_process').spawn(process.platform==='win32'?'explorer':process.platform==='darwin'?'open':'xdg-open',[require('path').resolve('dashboard-report/index.html')],{detached:true,stdio:'ignore'}).unref()\"",
    "codegen": "playwright codegen https://esignpro.net",
    "auth:save": "tsx scripts/save-auth.ts",
    "auth:refresh": "tsx scripts/refresh-auth.ts",
    "signup": "tsx scripts/signup.ts",
    "typecheck": "tsc --noEmit",
    "report:archive": "node scripts/archive-reports.mjs",
    "qa:reports": "python qa-reports/generate_reports.py",
    "test:all": "node scripts/run-all.mjs",
    "test:account": "playwright test --project=chromium-account"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.0.0",
    "dotenv": "^17.2.3",
    "imapflow": "^1.0.164",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
